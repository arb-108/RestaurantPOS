<Window x:Class="RestaurantPOS.WPF.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantPOS.WPF.Views"
        mc:Ignorable="d"
        Title="Authentication" Height="215" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

	<Grid Background="White" Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Label -->
		<TextBlock Grid.Row="0"
                   Text="Admin Password"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#424242"
                   Margin="0 0 0 8"/>

		<!-- Password Field -->
		<PasswordBox x:Name="PasswordBox"
                     Grid.Row="1"
                     Height="40" FontSize="14"
                     Padding="10 0"
                     VerticalContentAlignment="Center"
                     BorderThickness="1"
                     KeyDown="PasswordBox_KeyDown">
			<PasswordBox.Style>
				<Style TargetType="PasswordBox">
					<Setter Property="BorderBrush" Value="#BDBDBD"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding ElementName=ErrorPanel, Path=Visibility}"
                                     Value="Visible">
							<Setter Property="BorderBrush" Value="#1565C0"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</PasswordBox.Style>
		</PasswordBox>

		<!-- Error Message -->
		<StackPanel x:Name="ErrorPanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Visibility="Collapsed"
                    Margin="0 6 0 0">
			<TextBlock x:Name="ErrorText"
                       Text="Incorrect Password"
                       Foreground="#D32F2F"
                       FontSize="12"
                       VerticalAlignment="Center"/>
		</StackPanel>

		<!-- Buttons -->
		<StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 16 0 0">
			<Button Content="Cancel"
                    Width="85" Height="34"
                    Margin="0 0 10 0"
                    Background="White"
                    Foreground="#424242"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Cancel_Click"/>
			<Button Content="Confirm"
                    Width="85" Height="34"
                    Background="#1565C0"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Confirm_Click"/>
		</StackPanel>

	</Grid>
</Window>